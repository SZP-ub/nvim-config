	-- 在 lua/plugins/obsidian.lua 的 return 配置块底部加入：
	init = function()
		vim.api.nvim_create_autocmd("FileType", {
			pattern = "markdown",
			callback = function()
				vim.opt_local.conceallevel = 2
			end,
		})
