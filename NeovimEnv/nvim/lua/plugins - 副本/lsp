-- 小工具：安全 require（统一封装 pcall(require, ...)）
local function safe_require(name)
	local ok, mod = pcall(require, name)
	if ok then
		return mod
	end
	return nil
end

return {
	---------------------------------------------------------------------------
	-- 1. mason.nvim：负责底层二进制工具的管理和环境注入
	---------------------------------------------------------------------------
	{
		"mason-org/mason.nvim",
		event = "VeryLazy",
		opts = {
