	{
		"OXY2DEV/markview.nvim",
		lazy = false,
		priority = 100,
		config = function()
			local markview = require("markview")

			markview.setup({
				preview = {
					auto_start = true,
					icon_provider = "devicons",
				},

				bullets = {
					enabled = true,
					icons = { "●", "○", "◆", "◇" },
					ordered = function(ctx)
						local value = vim.trim(ctx.value)
						local index = tonumber(value:sub(1, #value - 1))
						return ("%d."):format(index > 1 and index or ctx.index)
					end,
				},

				checkboxes = {
					enabled = true,
					unchecked = {
						icon = "󰄱 ",
					},
					checked = {
						icon = "󰱒 ",
					},
					custom = {
						todo = {
							raw = "[-]",
							rendered = "󰥔 ",
						},
					},
				},

				quote = {
					enabled = true,
					icon = "▋",
				},

				links = {
					enabled = true,
				},

				callouts = {
					enabled = true,
					styles = {
						note = { icon = "󰋽 " },
						tip = { icon = "󰌶 " },
						important = { icon = "󰅾 " },
						warning = { icon = "󰀪 " },
						caution = { icon = "󰳦 " },
						info = { icon = "󰋽 " },
						success = { icon = "󰄬 " },
						danger = { icon = "󱐌 " },
						error = { icon = "󱐌 " },
						bug = { icon = "󰨰 " },
						quote = { icon = "󱆨 " },
						example = { icon = "󰉹 " },
					},
				},

				anti_conceal = {
					enabled = true,
					ignore = {
						code_background = true,
						sign = true,
					},
				},
			})

			-- ==========================================
			-- Obsidian 日语振假名 (Furigana) 终端内联渲染
			-- ==========================================
			local ns = vim.api.nvim_create_namespace("obsidian_furigana")

			local function render_furigana(bufnr)
				bufnr = bufnr or vim.api.nvim_get_current_buf()
				if not vim.api.nvim_buf_is_valid(bufnr) or vim.bo[bufnr].filetype ~= "markdown" then
					return
				end

				-- 确保开启 conceal 隐藏符号
				vim.opt_local.conceallevel = 2

				vim.api.nvim_buf_clear_namespace(bufnr, ns, 0, -1)
				local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)

				for row, line in ipairs(lines) do
					local init = 1
					while true do
						-- 匹配 {汉字|假名} 格式
						local s, e, kanji, ruby = line:find("%{([^|}]+)|([^}]+)%}", init)
						if not s then
							break
						end

						-- 将 お|の 拼接为 おの
						local kana = ruby:gsub("|", "")
						local pipe_idx = s + #kanji

						-- 1. 隐藏开头的 '{'
						pcall(vim.api.nvim_buf_set_extmark, bufnr, ns, row - 1, s - 1, {
							end_col = s,
							conceal = "",
						})

						-- 2. 隐藏 '|假名}' 部分
						pcall(vim.api.nvim_buf_set_extmark, bufnr, ns, row - 1, pipe_idx, {
							end_col = e,
							conceal = "",
						})

						-- 3. 在其后内联附加显示淡灰色的 (假名)
						pcall(vim.api.nvim_buf_set_extmark, bufnr, ns, row - 1, e, {
							virt_text = { { " (" .. kana .. ")", "Comment" } },
							virt_text_pos = "inline",
						})

						init = e + 1
					end
				end
			end

			-- 自动监听 Markdown 文件的进入与修改事件
			vim.api.nvim_create_autocmd({ "BufEnter", "TextChanged", "InsertLeave" }, {
				pattern = "*.md",
				callback = function(args)
					render_furigana(args.buf)
				end,
			})
		end,
	},

