return {
	{
		"epwalsh/obsidian.nvim",
		version = "*",
		lazy = true,
		ft = "markdown",
		dependencies = {
			"nvim-lua/plenary.nvim",
		},
		opts = {
			workspaces = {
				{
					name = "StoreH",
					path = "E:/Obsidian/StoreH",
				},
			},

			notes_subdir = "notes",
			new_notes_location = "notes_subdir",

			-- 模板系统配置
			templates = {
				folder = "Templater",
				date_format = "%Y-%m-%d",
				time_format = "%H:%M",
			},

			-- 日记与模板联动
			daily_notes = {
				folder = "dailies",
				date_format = "%Y-%m-%d",
				default_tags = { "daily-notes" },
				template = "daily.md",
			},

			preferred_link_style = "wiki",
			completion = {
				nvim_cmp = true,
				min_chars = 2,
			},

			-- 中文/英文友好的命名规则
			note_id_func = function(title)
				if title ~= nil and title ~= "" then
					return title:gsub(" ", "-"):gsub("[^%w%-_一-龥]", "")
				else
					return tostring(os.time())
				end
			end,

			-- 禁用 lua 内置 picker（适配你的 fzf.vim）
			picker = {
				name = nil,
			},

			ui = {
				enable = true,
			},

			follow_url_func = function(url)
				if vim.ui.open then
					vim.ui.open(url)
				else
					vim.cmd(':silent exec "!start ' .. url .. '"')
				end
			end,
		},

		keys = {
			{ "<leader>on", "<cmd>ObsidianNew<cr>", desc = "新建笔记" },
			{ "<leader>od", "<cmd>ObsidianToday<cr>", desc = "今日日记 (自动套用模板)" },
			{ "<leader>ob", "<cmd>ObsidianBacklinks<cr>", desc = "查看反向链接" },
			{ "<leader>ot", "<cmd>ObsidianTemplate<cr>", desc = "插入模板" },
			{ "<leader>oo", "<cmd>ObsidianOpen<cr>", desc = "在 Obsidian 桌面端打开" },
			-- 联动 fzf.vim 全文与文件检索
			{
				"<leader>oq",
				function()
					vim.fn["fzf#vim#files"]("E:/Obsidian/StoreH")
				end,
				desc = "fzf 快速查找笔记",
			},
			{
				"<leader>os",
				function()
					vim.fn["fzf#vim#grep"](
						"rg --column --line-number --no-heading --color=always --smart-case -- .",
						1,
						vim.fn["fzf#vim#with_preview"]({ dir = "E:/Obsidian/StoreH" }),
						0
					)
				end,
				desc = "fzf 全局搜索笔记",
			},
		},

		-- 将初始化与 conceallevel 逻辑放入插件内部的 init 钩子中
		init = function()
			vim.api.nvim_create_autocmd("FileType", {
				pattern = "markdown",
				callback = function()
					vim.opt_local.conceallevel = 2
				end,
			})
		end,
	},

