					map("grd", vim.lsp.buf.declaration, "跳转到声明")

					-- 跳转到上一个诊断信息（移动到上一个报错 Error 或警告 Warning 处）
					map("[g", vim.diagnostic.goto_prev, "跳转到上一个错误/警告")

